{
  "name": "rechrome",
  "version": "0.0.0-semantically-released",
  "repository": {
    "type": "git",
    "url": "https://github.com/snomiao/rechrome.git"
  },
  "bin": {
    "rech": "./rechrome.ts",
    "rechrome": "./rechrome.ts"
  },
  "files": [
    ".env.example",
    "LICENSE",
    "README.md",
    "skills/rechrome-setup",
    "extension-token.js",
    "extension-token.ts",
    "daemon-manager.js",
    "daemon-manager.ts",
    "listeners.ts",
    "listeners.js",
    "extension",
    "rechrome.js",
    "rechrome.ts",
    "serve.js",
    "serve.ts",
    "vendor"
  ],
  "type": "module",
  "scripts": {
    "serve": "bun run rechrome.ts serve",
    "test": "bun test",
    "vendor-cli": "bash scripts/vendor-cli.sh",
    "prepublishOnly": "bash scripts/vendor-cli.sh && sed 's/\\.ts/\\.js/g' rechrome.ts > rechrome.js && sed 's/\\.ts/\\.js/g' serve.ts > serve.js && bun build extension-token.ts --target=bun --outfile=extension-token.js && bun build daemon-manager.ts --target=bun --outfile=daemon-manager.js && bun build listeners.ts --target=bun --outfile=listeners.js"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/yargs": "^17.0.35"
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "dependencies": {
    "yargs": "^18.2.0"
  }
}
